{
  "name": "claude-code-sidebar",
  "displayName": "Claude Code Sidebar",
  "description": "Integrate Claude Code terminal into VS Code sidebar",
  "version": "0.0.1",
  "publisher": "diruuu",
  "repository": {
    "type": "git",
    "url": "https://github.com/diruuu/claude-code-sidebar"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:claudeCodeView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-code-sidebar",
          "title": "Claude Code",
          "icon": "resources/claude-icon.svg"
        }
      ]
    },
    "views": {
      "claude-code-sidebar": [
        {
          "type": "webview",
          "id": "claudeCodeView",
          "name": "Claude Terminal"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCode.openTerminal",
        "title": "Open Claude Code"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "postinstall": "npm run rebuild",
    "rebuild": "CXXFLAGS='-std=c++20' electron-rebuild -f -w node-pty -v 37.7.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0-beta39",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.0"
  }
}
